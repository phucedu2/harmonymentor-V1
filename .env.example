# Sao chép thành .env rồi điền giá trị: cp .env.example .env
# KHÔNG commit file .env (đã có trong .gitignore). Danh sách biến theo SRS 10.3.

# --- Docker Compose ---
# Bắt buộc khi chạy docker compose. Đặt một chuỗi bất kỳ, ví dụ sinh bằng:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
DB_PASSWORD=

# --- Backend ---
# development | production. production bắt buộc có JWT_SECRET.
APP_ENV=development

# Chạy ngoài Docker: để trống thì dùng SQLite dev (backend/harmonymentor_dev.db).
# Trong Docker, compose tự đặt DATABASE_URL và REDIS_URL, giá trị ở đây bị bỏ qua.
DATABASE_URL=
REDIS_URL=

# Khóa ký JWT (ADR-004). Để trống ở dev thì dùng khóa tạm theo tiến trình. Sinh khóa:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
# true khi chạy qua HTTPS
COOKIE_SECURE=false
# true khi API đứng sau reverse proxy tin cậy (compose tự đặt cho dịch vụ api)
TRUST_PROXY=false
# Origin frontend được gọi API từ origin khác, phân tách bằng dấu phẩy. Để trống khi cùng origin.
CORS_ORIGINS=
# Hiện câu hỏi bản nháp (chưa được Đạt duyệt) cho người học. Chỉ bật khi soạn/duyệt nội dung ở máy dev.
# APP_ENV=production mà bật thì API từ chối khởi động (PR-3, ADR-006).
SHOW_DRAFT_CONTENT=false

# --- AI (dùng từ Giai đoạn D–E) ---
AI_ENABLED=false
# Khóa chỉ đặt ở đây, không dán vào chat hay commit.
GEMINI_API_KEY=
AI_DAILY_QUOTA=30
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
CONTENT_DIR=content
