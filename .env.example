# Sao chép thành .env rồi điền giá trị: cp .env.example .env
# KHÔNG commit file .env (đã có trong .gitignore). Danh sách biến theo SRS 10.3.

# --- Docker Compose ---
# Bắt buộc khi chạy docker compose. Đặt một chuỗi bất kỳ, ví dụ sinh bằng:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
DB_PASSWORD=

# --- Backend ---
# development | production. production bắt buộc có JWT_SECRET.
APP_ENV=development

# Chạy ngoài Docker: để trống thì dùng SQLite dev (backend/harmonymentor_dev.db).
# Trong Docker, compose tự đặt DATABASE_URL và REDIS_URL, giá trị ở đây bị bỏ qua.
DATABASE_URL=
REDIS_URL=

# Khóa ký JWT (ADR-004). Để trống ở dev thì dùng khóa tạm theo tiến trình. Sinh khóa:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
# true khi chạy qua HTTPS
COOKIE_SECURE=false
# true khi API đứng sau reverse proxy tin cậy (compose tự đặt cho dịch vụ api)
TRUST_PROXY=false
# Origin frontend được gọi API từ origin khác, phân tách bằng dấu phẩy. Để trống khi cùng origin.
CORS_ORIGINS=
# Hiện câu hỏi bản nháp (chưa được Đạt duyệt) cho người học. Chỉ bật khi soạn/duyệt nội dung ở máy dev.
# APP_ENV=production mà bật thì API từ chối khởi động (PR-3, ADR-006).
SHOW_DRAFT_CONTENT=false

# --- Cổng nhạc lý cho tài liệu Admin tải lên (góp ý thầy T1). Mọi giá trị ghi đè được; mặc định như dưới ---
# Dưới LOW: từ chối. Từ LOW tới dưới HIGH: chờ Quản trị viên duyệt. Từ HIGH trở lên: nhận. Hiệu chỉnh theo dữ liệu thật.
# RELEVANCE_LOW=0.35
# RELEVANCE_HIGH=0.60
# RELEVANCE_SCORER=hybrid        # hybrid = từ vựng + nhúng e5; lexicon = chỉ từ vựng; classifier = bộ phân loại tự train (G6, docs/MODEL_CARD.md)
# RELEVANCE_MODEL=auto           # auto | tfidf | e5 (chỉ khi RELEVANCE_SCORER=classifier)
# RELEVANCE_MODEL_DIR=backend/models/relevance
# OCR_LANG=vie+eng

# --- Model dự đoán làm đúng câu tiếp theo (ADR-031). Mặc định tắt; bật thì có GET /api/v1/me/predictions ---
# Chỉ là thông tin thêm, không đổi mastery EMA hay thứ tự gợi ý. Model train trên người học mô phỏng.
PREDICT_ENABLED=false
# PREDICT_MODEL_DIR=/app/models/correctness

# --- AI (dùng từ Giai đoạn D–E) ---
AI_ENABLED=false
# Khóa chỉ đặt ở đây, không dán vào chat hay commit.
GEMINI_API_KEY=
AI_DAILY_QUOTA=30
# Embedding Gemini thay MiniLM (KE_HOACH_AI GĐ0, ADR-014 sẽ ghi). Vector được chuẩn hóa trong backend.
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
# Chỉ dev/demo: cho tầng nội dung dùng mô tả kỹ năng còn nháp. Bị chặn khi APP_ENV=production.
ALLOW_DRAFT_SKILL_DESCRIPTIONS=0
# Hệ gợi ý (ADR-008 mục 5): ngưỡng số chiều chung 2/3/4 (tạm 3), dự phòng a hoặc b.
RECO_MIN_SHARED_DIMS=3
RECO_FALLBACK=a
# Tắt tầng cộng tác (KNN) để so sánh; trọng số content,mastery,due,cf (tổng 1).
RECO_USE_CF=1
RECO_WEIGHTS=0.35,0.25,0.20,0.20
# AI Tutor (GĐ3, ADR-015). Mô hình đã xác nhận bằng models.list ở GĐ0; lần thử lại dùng mô hình dự phòng.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
AI_TIMEOUT_SECONDS=8
# Trần lượt gọi Gemini của cả hệ thống mỗi ngày (chống sự cố đốt hết hạn mức).
AI_GLOBAL_DAILY_BUDGET=1000
# Hạn mức Gemini chung (ADR-033, V5): bản miễn phí 30 lượt/ngày, đặt lại 15:00 giờ VN (nửa đêm giờ Thái Bình Dương).
# 40% cho Admin soạn bài (12 lượt), 60% cho AI Tutor (18 lượt). 0 = không giới hạn (chỉ còn AI_GLOBAL_DAILY_BUDGET).
GEMINI_DAILY_BUDGET=30
GEMINI_AUTHORING_SHARE=0.4
# Đo bám nguồn / chống trùng bằng e5 cục bộ khi máy có mô hình; 0 = dùng TF-IDF như CI.
AI_GROUND_E5=1
AI_DEDUP_E5=1
RAG_TOP_K=4
# Hiệu chỉnh cho gemini-embedding-001 (báo cáo ai-gd3 mục C). Đổi mô hình embedding thì phải hiệu chỉnh lại.
RAG_MIN_SCORE=0.60
RAG_BM25_MIN_SCORE=2.0
CONTENT_DIR=content

# Qdrant (G3/T3). Rỗng = tắt, AI Tutor dùng đường e5 + BM25 như cũ. Docker compose tự đặt http://qdrant:6333.
QDRANT_URL=
QDRANT_COLLECTION=harmony_knowledge
QDRANT_TOP_K=5
# G5 hiệu chỉnh (eval/report.md mục 2). Cosine e5 bị nén nên ngưỡng cao hơn RAG_MIN_SCORE (Gemini) ở trên.
QDRANT_MIN_SCORE=0.84
# e5 (cục bộ, mặc định) hoặc fake (chỉ test)
RAG_EMBEDDER=e5
RAG_CORPUS_DIR=data/corpus/raw

# Pipeline chatbot (G4, docs/AI_PIPELINE.md)
# 1 = bước Retrieve hỏi Qdrant (cần QDRANT_URL và đã chạy: python -m app.rag.ingest --source lessons). Lỗi/chưa nạp thì tự lùi về đường cũ.
RAG_ENABLED=0
RAG_SOURCES=lessons
# Trọng số rerank theo từ khóa. 0 = tắt (G5 đo: bật không giúp); xem eval/report.md
RAG_RERANK_WEIGHT=0
# Số lượt hỏi tối đa mỗi người mỗi phút (0 = tắt)
CHAT_RATE_LIMIT_PER_MIN=20
# brief = câu lạc đề trả lời tối đa OFFTOPIC_MAX_SENTENCES câu rồi dẫn về nhạc lý; refuse = chỉ từ chối (ADR-020)
OFFTOPIC_MODE=brief
OFFTOPIC_MAX_SENTENCES=2
# 1 = truy xuất không đủ tin cậy thì "mình không biết" + gợi ý bài, không để Gemini trả lời kiến thức chung
RAG_STRICT_GROUNDING=0
# Giá mỗi 1 triệu token (USD) để ước tính chi phí trong nhật ký; 0 = không ghi chi phí
AI_PRICE_IN_PER_M=0
AI_PRICE_OUT_PER_M=0
