# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit file .env.

# Môi trường: development | production. production bắt buộc có JWT_SECRET.
APP_ENV=development

# CSDL. Để trống thì backend dùng SQLite dev (backend/harmonymentor_dev.db).
DATABASE_URL=

# Xác thực (ADR-004). Tạo khóa: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=thay-bang-chuoi-ngau-nhien-dai
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
# true khi chạy qua HTTPS
COOKIE_SECURE=false

# Bộ đếm khóa đăng nhập. Để trống thì dùng bộ nhớ trong (chỉ hợp với 1 tiến trình).
REDIS_URL=
# true khi API đứng sau reverse proxy tin cậy (nginx trong Docker) để lấy IP thật
TRUST_PROXY=false
