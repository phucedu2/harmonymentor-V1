# Sao chép thành .env rồi điền giá trị: cp .env.example .env
# KHÔNG commit file .env (đã có trong .gitignore). Danh sách biến theo SRS 10.3.

# --- Docker Compose ---
# Bắt buộc khi chạy docker compose. Đặt một chuỗi bất kỳ, ví dụ sinh bằng:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
DB_PASSWORD=

# --- Backend ---
# development | production. production bắt buộc có JWT_SECRET.
APP_ENV=development

# Chạy ngoài Docker: để trống thì dùng SQLite dev (backend/harmonymentor_dev.db).
# Trong Docker, compose tự đặt DATABASE_URL và REDIS_URL, giá trị ở đây bị bỏ qua.
DATABASE_URL=
REDIS_URL=

# Khóa ký JWT (ADR-004). Để trống ở dev thì dùng khóa tạm theo tiến trình. Sinh khóa:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
# true khi chạy qua HTTPS
COOKIE_SECURE=false
# true khi API đứng sau reverse proxy tin cậy (compose tự đặt cho dịch vụ api)
TRUST_PROXY=false
# Origin frontend được gọi API từ origin khác, phân tách bằng dấu phẩy. Để trống khi cùng origin.
CORS_ORIGINS=
# Hiện câu hỏi bản nháp (chưa được Đạt duyệt) cho người học. Chỉ bật khi soạn/duyệt nội dung ở máy dev.
# APP_ENV=production mà bật thì API từ chối khởi động (PR-3, ADR-006).
SHOW_DRAFT_CONTENT=false

# --- AI (dùng từ Giai đoạn D–E) ---
AI_ENABLED=false
# Khóa chỉ đặt ở đây, không dán vào chat hay commit.
GEMINI_API_KEY=
AI_DAILY_QUOTA=30
# Embedding Gemini thay MiniLM (KE_HOACH_AI GĐ0, ADR-014 sẽ ghi). Vector được chuẩn hóa trong backend.
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
# Chỉ dev/demo: cho tầng nội dung dùng mô tả kỹ năng còn nháp. Bị chặn khi APP_ENV=production.
ALLOW_DRAFT_SKILL_DESCRIPTIONS=0
# Hệ gợi ý (ADR-008 mục 5): ngưỡng số chiều chung 2/3/4 (tạm 3), dự phòng a hoặc b.
RECO_MIN_SHARED_DIMS=3
RECO_FALLBACK=a
# Tắt tầng cộng tác (KNN) để so sánh; trọng số content,mastery,due,cf (tổng 1).
RECO_USE_CF=1
RECO_WEIGHTS=0.35,0.25,0.20,0.20
# AI Tutor (GĐ3, ADR-015). Mô hình đã xác nhận bằng models.list ở GĐ0; lần thử lại dùng mô hình dự phòng.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
AI_TIMEOUT_SECONDS=15
# Trần lượt gọi Gemini của cả hệ thống mỗi ngày (chống sự cố đốt hết hạn mức).
AI_GLOBAL_DAILY_BUDGET=1000
RAG_TOP_K=4
# Hiệu chỉnh cho gemini-embedding-001 (báo cáo ai-gd3 mục C). Đổi mô hình embedding thì phải hiệu chỉnh lại.
RAG_MIN_SCORE=0.60
RAG_BM25_MIN_SCORE=2.0
CONTENT_DIR=content
