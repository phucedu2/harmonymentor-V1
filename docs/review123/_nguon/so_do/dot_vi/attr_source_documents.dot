graph G {
  graph [fontname="Liberation Serif", bgcolor=white, pad=0.2 , layout=neato, overlap=false, sep="+4"];
  node [fontname="Liberation Serif", fontsize=11, color=black];
  edge [fontname="Liberation Serif", fontsize=9, color=black];
  E [shape=box, style=bold, fontsize=16, label="source_documents"];
  a0 [shape=ellipse, fontsize=14, margin="0.05,0.02", label=<<U>id</U>>];
  E -- a0 [len=2.6];
  a1 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="uploaded_by"];
  E -- a1 [len=2.6];
  a2 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="filename"];
  E -- a2 [len=2.6];
  a3 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="kind"];
  E -- a3 [len=2.6];
  a4 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="size_bytes"];
  E -- a4 [len=2.6];
  a5 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="sha256"];
  E -- a5 [len=2.6];
  a6 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="source_title"];
  E -- a6 [len=2.6];
  a7 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="source_note"];
  E -- a7 [len=2.6];
  a8 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="consent"];
  E -- a8 [len=2.6];
  a9 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="pages"];
  E -- a9 [len=2.6];
  a10 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="relevance_status"];
  E -- a10 [len=2.6];
  a11 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="relevance_score"];
  E -- a11 [len=2.6];
  a12 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="relevance_reason"];
  E -- a12 [len=2.6];
  a13 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="relevance_detail"];
  E -- a13 [len=2.6];
  a14 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="reviewed_by"];
  E -- a14 [len=2.6];
  a15 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="reviewed_at"];
  E -- a15 [len=2.6];
  a16 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="created_at"];
  E -- a16 [len=2.6];
  a17 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="deleted_at"];
  E -- a17 [len=2.6];
}
