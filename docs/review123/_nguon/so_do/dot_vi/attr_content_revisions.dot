graph G {
  graph [fontname="Liberation Serif", bgcolor=white, pad=0.2 , layout=neato, overlap=false, sep="+4"];
  node [fontname="Liberation Serif", fontsize=11, color=black];
  edge [fontname="Liberation Serif", fontsize=9, color=black];
  E [shape=box, style=bold, fontsize=16, label="content_revisions"];
  a0 [shape=ellipse, fontsize=14, margin="0.05,0.02", label=<<U>id</U>>];
  E -- a0 [len=2.1];
  a1 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="lesson_id"];
  E -- a1 [len=2.1];
  a2 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="kind"];
  E -- a2 [len=2.1];
  a3 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="target"];
  E -- a3 [len=2.1];
  a4 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="payload"];
  E -- a4 [len=2.1];
  a5 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="status"];
  E -- a5 [len=2.1];
  a6 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="note"];
  E -- a6 [len=2.1];
  a7 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="created_by"];
  E -- a7 [len=2.1];
  a8 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="created_at"];
  E -- a8 [len=2.1];
  a9 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="published_by"];
  E -- a9 [len=2.1];
  a10 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="published_at"];
  E -- a10 [len=2.1];
}
