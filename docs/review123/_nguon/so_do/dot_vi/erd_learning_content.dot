graph G {
  graph [fontname="Liberation Serif", bgcolor=white, pad=0.2 , layout=neato, overlap=false, sep="+14", splines=true, size="7.2,9.2"];
  node [fontname="Liberation Serif", fontsize=11, color=black];
  edge [fontname="Liberation Serif", fontsize=9, color=black];
  "skills" [shape=box, style=bold, fontsize=12];
  "skill_prerequisites" [shape=box, style=bold, fontsize=12];
  "lessons" [shape=box, style=bold, fontsize=12];
  "lesson_blocks" [shape=box, style=bold, fontsize=12];
  "source_works" [shape=box, style=bold, fontsize=12];
  "lesson_sources" [shape=box, style=bold, fontsize=12];
  "exercises" [shape=box, style=bold, fontsize=12];
  "exercise_versions" [shape=box, style=bold, fontsize=12];
  "review_items" [shape=box, style=bold, fontsize=12];
  "R_skill_prerequisites_skills_skill_id" [shape=diamond, fontsize=9, width=0.9, height=0.5, label="cần"];
  "skills" -- "R_skill_prerequisites_skills_skill_id" [label="1"];
  "R_skill_prerequisites_skills_skill_id" -- "skill_prerequisites" [label="n"];
  "R_skill_prerequisites_skills_prerequisite_skill_id" [shape=diamond, fontsize=9, width=0.9, height=0.5, label="prerequisite skill id"];
  "skills" -- "R_skill_prerequisites_skills_prerequisite_skill_id" [label="1"];
  "R_skill_prerequisites_skills_prerequisite_skill_id" -- "skill_prerequisites" [label="n"];
  "R_lesson_blocks_lessons_lesson_id" [shape=diamond, fontsize=9, width=0.9, height=0.5, label="chứa"];
  "lessons" -- "R_lesson_blocks_lessons_lesson_id" [label="1"];
  "R_lesson_blocks_lessons_lesson_id" -- "lesson_blocks" [label="n"];
  "R_lesson_sources_lessons_lesson_id" [shape=diamond, fontsize=9, width=0.9, height=0.5, label="trích"];
  "lessons" -- "R_lesson_sources_lessons_lesson_id" [label="1"];
  "R_lesson_sources_lessons_lesson_id" -- "lesson_sources" [label="n"];
  "R_lesson_sources_source_works_source_work_id" [shape=diamond, fontsize=9, width=0.9, height=0.5, label="dùng trong"];
  "source_works" -- "R_lesson_sources_source_works_source_work_id" [label="1"];
  "R_lesson_sources_source_works_source_work_id" -- "lesson_sources" [label="n"];
  "R_exercises_lessons_lesson_id" [shape=diamond, fontsize=9, width=0.9, height=0.5, label="có"];
  "lessons" -- "R_exercises_lessons_lesson_id" [label="1"];
  "R_exercises_lessons_lesson_id" -- "exercises" [label="n"];
  "R_exercises_skills_skill_id" [shape=diamond, fontsize=9, width=0.9, height=0.5, label="luyện"];
  "skills" -- "R_exercises_skills_skill_id" [label="1"];
  "R_exercises_skills_skill_id" -- "exercises" [label="n"];
  "R_exercise_versions_exercises_exercise_id" [shape=diamond, fontsize=9, width=0.9, height=0.5, label="có phiên bản"];
  "exercises" -- "R_exercise_versions_exercises_exercise_id" [label="1"];
  "R_exercise_versions_exercises_exercise_id" -- "exercise_versions" [label="n"];
  "R_review_items_lessons_lesson_id" [shape=diamond, fontsize=9, width=0.9, height=0.5, label="có thẻ"];
  "lessons" -- "R_review_items_lessons_lesson_id" [label="1"];
  "R_review_items_lessons_lesson_id" -- "review_items" [label="n"];
  "R_review_items_skills_skill_id" [shape=diamond, fontsize=9, width=0.9, height=0.5, label="ôn"];
  "skills" -- "R_review_items_skills_skill_id" [label="1"];
  "R_review_items_skills_skill_id" -- "review_items" [label="n"];
}
