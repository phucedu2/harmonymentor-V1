graph G {
  graph [fontname="Liberation Serif", bgcolor=white, pad=0.2 , layout=neato, overlap=false, sep="+14", splines=true, size="7.2,9.2"];
  node [fontname="Liberation Serif", fontsize=11, color=black];
  edge [fontname="Liberation Serif", fontsize=9, color=black];
  "users" [shape=box, style=bold, fontsize=12];
  "refresh_tokens" [shape=box, style=bold, fontsize=12];
  "exercise_versions" [shape=box, style=bold, fontsize=12];
  "attempts" [shape=box, style=bold, fontsize=12];
  "attempt_errors" [shape=box, style=bold, fontsize=12];
  "lessons" [shape=box, style=bold, fontsize=12];
  "lesson_progress" [shape=box, style=bold, fontsize=12];
  "review_items" [shape=box, style=bold, fontsize=12];
  "review_states" [shape=box, style=bold, fontsize=12];
  "review_attempts" [shape=box, style=bold, fontsize=12];
  "practice_attempts" [shape=box, style=bold, fontsize=12];
  "skills" [shape=box, style=bold, fontsize=12];
  "mastery_states" [shape=box, style=bold, fontsize=12];
  "mastery_events" [shape=box, style=bold, fontsize=12];
  "placement_results" [shape=box, style=bold, fontsize=12];
  "R_refresh_tokens_users_user_id" [shape=diamond, fontsize=9, width=0.9, height=0.5, label="sở hữu"];
  "users" -- "R_refresh_tokens_users_user_id" [label="1"];
  "R_refresh_tokens_users_user_id" -- "refresh_tokens" [label="n"];
  "R_attempts_users_user_id" [shape=diamond, fontsize=9, width=0.9, height=0.5, label="thực hiện"];
  "users" -- "R_attempts_users_user_id" [label="1"];
  "R_attempts_users_user_id" -- "attempts" [label="n"];
  "R_attempts_exercise_versions_exercise_version_id" [shape=diamond, fontsize=9, width=0.9, height=0.5, label="trả lời"];
  "exercise_versions" -- "R_attempts_exercise_versions_exercise_version_id" [label="1"];
  "R_attempts_exercise_versions_exercise_version_id" -- "attempts" [label="n"];
  "R_attempt_errors_attempts_attempt_id" [shape=diamond, fontsize=9, width=0.9, height=0.5, label="chẩn đoán"];
  "attempts" -- "R_attempt_errors_attempts_attempt_id" [label="1"];
  "R_attempt_errors_attempts_attempt_id" -- "attempt_errors" [label="n"];
  "R_lesson_progress_users_user_id" [shape=diamond, fontsize=9, width=0.9, height=0.5, label="theo dõi"];
  "users" -- "R_lesson_progress_users_user_id" [label="1"];
  "R_lesson_progress_users_user_id" -- "lesson_progress" [label="n"];
  "R_lesson_progress_lessons_lesson_id" [shape=diamond, fontsize=9, width=0.9, height=0.5, label="tiến độ của"];
  "lessons" -- "R_lesson_progress_lessons_lesson_id" [label="1"];
  "R_lesson_progress_lessons_lesson_id" -- "lesson_progress" [label="n"];
  "R_review_items_lessons_lesson_id" [shape=diamond, fontsize=9, width=0.9, height=0.5, label="có thẻ"];
  "lessons" -- "R_review_items_lessons_lesson_id" [label="1"];
  "R_review_items_lessons_lesson_id" -- "review_items" [label="n"];
  "R_review_items_skills_skill_id" [shape=diamond, fontsize=9, width=0.9, height=0.5, label="ôn"];
  "skills" -- "R_review_items_skills_skill_id" [label="1"];
  "R_review_items_skills_skill_id" -- "review_items" [label="n"];
  "R_review_states_users_user_id" [shape=diamond, fontsize=9, width=0.9, height=0.5, label="xếp lịch"];
  "users" -- "R_review_states_users_user_id" [label="1"];
  "R_review_states_users_user_id" -- "review_states" [label="n"];
  "R_review_states_review_items_review_item_id" [shape=diamond, fontsize=9, width=0.9, height=0.5, label="trạng thái của"];
  "review_items" -- "R_review_states_review_items_review_item_id" [label="1"];
  "R_review_states_review_items_review_item_id" -- "review_states" [label="n"];
  "R_review_attempts_review_states_review_state_id" [shape=diamond, fontsize=9, width=0.9, height=0.5, label="ghi lại"];
  "review_states" -- "R_review_attempts_review_states_review_state_id" [label="1"];
  "R_review_attempts_review_states_review_state_id" -- "review_attempts" [label="n"];
