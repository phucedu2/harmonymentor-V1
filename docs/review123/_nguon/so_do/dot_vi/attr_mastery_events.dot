graph G {
  graph [fontname="Liberation Serif", bgcolor=white, pad=0.2 , layout=neato, overlap=false, sep="+4"];
  node [fontname="Liberation Serif", fontsize=11, color=black];
  edge [fontname="Liberation Serif", fontsize=9, color=black];
  E [shape=box, style=bold, fontsize=16, label="mastery_events"];
  a0 [shape=ellipse, fontsize=14, margin="0.05,0.02", label=<<U>id</U>>];
  E -- a0 [len=2.1];
  a1 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="user_id"];
  E -- a1 [len=2.1];
  a2 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="skill_id"];
  E -- a2 [len=2.1];
  a3 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="source"];
  E -- a3 [len=2.1];
  a4 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="source_id"];
  E -- a4 [len=2.1];
  a5 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="result"];
  E -- a5 [len=2.1];
  a6 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="counted"];
  E -- a6 [len=2.1];
  a7 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="score_before"];
  E -- a7 [len=2.1];
  a8 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="score_after"];
  E -- a8 [len=2.1];
  a9 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="vn_day"];
  E -- a9 [len=2.1];
  a10 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="created_at"];
  E -- a10 [len=2.1];
}
