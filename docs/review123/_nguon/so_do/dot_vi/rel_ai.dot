digraph G {
  graph [fontname="Liberation Serif", bgcolor=white, pad=0.2 , rankdir=LR, nodesep=0.25, ranksep=0.9, splines=true];
  node [fontname="Liberation Serif", fontsize=11, color=black];
  edge [fontname="Liberation Serif", fontsize=9, color=black];
  "recommendation_logs" [shape=plaintext, fontsize=9, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="black"><FONT COLOR="white"><B>recommendation_logs</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">user_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="lesson_ids">lesson_ids</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="scores">scores</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="explanation">explanation</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="context">context</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="clicked_lesson_id">clicked_lesson_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="clicked_at">clicked_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR></TABLE>>];
  "chat_sessions" [shape=plaintext, fontsize=9, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="black"><FONT COLOR="white"><B>chat_sessions</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">user_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="mode">mode</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="summary">summary</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at">updated_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR></TABLE>>];
  "chat_messages" [shape=plaintext, fontsize=9, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="black"><FONT COLOR="white"><B>chat_messages</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="session_id">session_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="role">role</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="content">content</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="intent">intent</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="citations">citations</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="engine_claims">engine_claims</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tool_calls">tool_calls</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="hint_level">hint_level</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="latency_ms">latency_ms</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tokens_in">tokens_in</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tokens_out">tokens_out</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR></TABLE>>];
  "chat_feedback" [shape=plaintext, fontsize=9, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="black"><FONT COLOR="white"><B>chat_feedback</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="message_id">message_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">user_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="stars">stars</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="comment">comment</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR></TABLE>>];
  "chat_sessions":id -> "chat_messages":session_id [arrowhead=crow, arrowtail=tee, dir=both];
  "chat_messages":id -> "chat_feedback":message_id [arrowhead=crow, arrowtail=tee, dir=both];
}
