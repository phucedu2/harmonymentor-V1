digraph G {
  graph [fontname="Liberation Serif", bgcolor=white, pad=0.2 , rankdir=LR, nodesep=0.25, ranksep=0.9, splines=true];
  node [fontname="Liberation Serif", fontsize=11, color=black];
  edge [fontname="Liberation Serif", fontsize=9, color=black];
  "composition_projects" [shape=plaintext, fontsize=9, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="black"><FONT COLOR="white"><B>composition_projects</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">user_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name">name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="key">key</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tempo_bpm">tempo_bpm</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="time_signature">time_signature</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="bars">bars</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="style">style</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="is_test">is_test</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="seed">seed</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="energy">energy</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="mix">mix</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="arrangement_version">arrangement_version</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="form">form</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at">updated_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="deleted_at">deleted_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR></TABLE>>];
  "chord_events" [shape=plaintext, fontsize=9, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="black"><FONT COLOR="white"><B>chord_events</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="project_id">project_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="start_beat">start_beat</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="duration_beats">duration_beats</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="symbol">symbol</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR></TABLE>>];
  "drum_events" [shape=plaintext, fontsize=9, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="black"><FONT COLOR="white"><B>drum_events</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="project_id">project_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="drum">drum</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="start_beat">start_beat</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="velocity">velocity</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR></TABLE>>];
  "composition_projects":id -> "chord_events":project_id [arrowhead=crow, arrowtail=tee, dir=both];
  "composition_projects":id -> "drum_events":project_id [arrowhead=crow, arrowtail=tee, dir=both];
}
