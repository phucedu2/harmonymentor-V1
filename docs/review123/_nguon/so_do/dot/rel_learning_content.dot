digraph G {
  graph [fontname="Liberation Serif", bgcolor=white, pad=0.2 , rankdir=LR, nodesep=0.25, ranksep=0.9, splines=true];
  node [fontname="Liberation Serif", fontsize=11, color=black];
  edge [fontname="Liberation Serif", fontsize=9, color=black];
  "skills" [shape=plaintext, fontsize=9, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="black"><FONT COLOR="white"><B>skills</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name">name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="domain">domain</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="srs_code">srs_code</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="group_code">group_code</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ready_threshold">ready_threshold</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="mastery_threshold">mastery_threshold</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR></TABLE>>];
  "skill_prerequisites" [shape=plaintext, fontsize=9, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="black"><FONT COLOR="white"><B>skill_prerequisites</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="skill_id">skill_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="prerequisite_skill_id">prerequisite_skill_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK</FONT></TD></TR></TABLE>>];
  "lessons" [shape=plaintext, fontsize=9, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="black"><FONT COLOR="white"><B>lessons</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="order_index">order_index</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="track">track</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="title">title</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="objectives">objectives</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at">updated_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR></TABLE>>];
  "lesson_blocks" [shape=plaintext, fontsize=9, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="black"><FONT COLOR="white"><B>lesson_blocks</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="lesson_id">lesson_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="position">position</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="block_type">block_type</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="payload">payload</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR></TABLE>>];
  "source_works" [shape=plaintext, fontsize=9, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="black"><FONT COLOR="white"><B>source_works</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="title">title</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="author">author</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="url">url</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR></TABLE>>];
  "lesson_sources" [shape=plaintext, fontsize=9, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="black"><FONT COLOR="white"><B>lesson_sources</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="lesson_id">lesson_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="source_work_id">source_work_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="locator">locator</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="note">note</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR></TABLE>>];
  "exercises" [shape=plaintext, fontsize=9, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="black"><FONT COLOR="white"><B>exercises</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="lesson_id">lesson_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="skill_id">skill_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="kind">kind</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="prompt">prompt</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="options">options</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="grading_strategy">grading_strategy</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="position">position</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="active">active</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="deleted_at">deleted_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR></TABLE>>];
  "exercise_versions" [shape=plaintext, fontsize=9, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="black"><FONT COLOR="white"><B>exercise_versions</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="exercise_id">exercise_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="version">version</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="kind">kind</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="prompt">prompt</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="options">options</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="grading_strategy">grading_strategy</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="answer_key">answer_key</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="grader_config">grader_config</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="explanation">explanation</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="provenance">provenance</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="published_at">published_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="content_hash">content_hash</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="snapshot_origin">snapshot_origin</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR></TABLE>>];
  "review_items" [shape=plaintext, fontsize=9, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="black"><FONT COLOR="white"><B>review_items</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="lesson_id">lesson_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="skill_id">skill_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="mode">mode</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="front">front</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="back">back</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="grading_strategy">grading_strategy</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="answer_key">answer_key</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="grader_config">grader_config</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="provenance">provenance</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR></TABLE>>];
  "skills":id -> "skill_prerequisites":skill_id [arrowhead=crow, arrowtail=tee, dir=both];
  "skills":id -> "skill_prerequisites":prerequisite_skill_id [arrowhead=crow, arrowtail=tee, dir=both];
  "lessons":id -> "lesson_blocks":lesson_id [arrowhead=crow, arrowtail=tee, dir=both];
  "lessons":id -> "lesson_sources":lesson_id [arrowhead=crow, arrowtail=tee, dir=both];
  "source_works":id -> "lesson_sources":source_work_id [arrowhead=crow, arrowtail=tee, dir=both];
  "lessons":id -> "exercises":lesson_id [arrowhead=crow, arrowtail=tee, dir=both];
  "skills":id -> "exercises":skill_id [arrowhead=crow, arrowtail=tee, dir=both];
  "exercises":id -> "exercise_versions":exercise_id [arrowhead=crow, arrowtail=tee, dir=both];
  "lessons":id -> "review_items":lesson_id [arrowhead=crow, arrowtail=tee, dir=both];
  "skills":id -> "review_items":skill_id [arrowhead=crow, arrowtail=tee, dir=both];
}
