digraph G {
  graph [fontname="Liberation Serif", bgcolor=white, pad=0.2 , rankdir=LR, nodesep=0.12, ranksep=0.55];
  node [fontname="Liberation Serif", fontsize=11, color=black];
  edge [fontname="Liberation Serif", fontsize=9, color=black];
  node [shape=box, style=rounded, fontsize=10];
  root [label="/  Home (public)", style="rounded,bold"];
  login [label="/dang-nhap  Login"];
  reg [label="/dang-ky  Register"];
  nf [label="*  404 Not found"];
  prog [label="/#chuong-trinh  Curriculum"];
  feat [label="/#tinh-nang  Features"];
  app [label="/app  Dashboard\n[login required]", style="rounded,bold"];
  hoc [label="/app/hoc  Lessons"];
  bai [label="/app/hoc?bai=L01  Lesson runner"];
  lt [label="/app/luyen-tap  Practice"];
  td [label="/app/tien-do  Progress & flashcards"];
  quiz [label="/app/quiz  Skill quiz"];
  comp [label="/app/composition  Harmony Lab"];
  hs [label="/app/ho-so  Profile"];
  kt [label="/app/kiem-tra-dau-vao  Placement test"];
  ai [label="AI Tutor drawer\n(on every /app page)", style="rounded,dashed"];
  adm [label="/admin  Administration\n[role = admin, else 403]", style="rounded,bold"];
  t1 [label="Tab: Statistics"];
  t2 [label="Tab: Lessons (edit, preview,\npublish, history, hide)"];
  t3 [label="Tab: AI lesson drafts"];
  t4 [label="Tab: Users (lock / unlock)"];
  root -> login;
  root -> reg;
  root -> prog;
  root -> feat;
  root -> nf;
  login -> app;
  reg -> kt;
  root -> app;
  app -> hoc;
  hoc -> bai;
  app -> lt;
  app -> td;
  app -> quiz;
  app -> comp;
  app -> hs;
  app -> kt;
  app -> ai;
  login -> adm;
  adm -> t1;
  adm -> t2;
  adm -> t3;
  adm -> t4;
}
