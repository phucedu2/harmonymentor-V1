digraph G {
  graph [fontname="Liberation Serif", bgcolor=white, pad=0.2 , rankdir=LR, nodesep=0.25, ranksep=0.9, splines=true];
  node [fontname="Liberation Serif", fontsize=11, color=black];
  edge [fontname="Liberation Serif", fontsize=9, color=black];
  "users" [shape=plaintext, fontsize=9, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="black"><FONT COLOR="white"><B>users</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="display_name">display_name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="email">email</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="hashed_password">hashed_password</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="role">role</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="preferred_instrument">preferred_instrument</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="goal_text">goal_text</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="is_active">is_active</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="is_synthetic">is_synthetic</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="goal_embedding">goal_embedding</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="goal_embedding_model">goal_embedding_model</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR></TABLE>>];
  "refresh_tokens" [shape=plaintext, fontsize=9, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="black"><FONT COLOR="white"><B>refresh_tokens</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">user_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="token_hash">token_hash</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="expires_at">expires_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="revoked_at">revoked_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR></TABLE>>];
  "exercise_versions" [shape=plaintext, fontsize=9, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="black"><FONT COLOR="white"><B>exercise_versions</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="exercise_id">exercise_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="version">version</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="kind">kind</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="prompt">prompt</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="options">options</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="grading_strategy">grading_strategy</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="answer_key">answer_key</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="grader_config">grader_config</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="explanation">explanation</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="provenance">provenance</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="published_at">published_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="content_hash">content_hash</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="snapshot_origin">snapshot_origin</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR></TABLE>>];
  "attempts" [shape=plaintext, fontsize=9, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="black"><FONT COLOR="white"><B>attempts</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">user_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="exercise_version_id">exercise_version_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="answer">answer</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="correct">correct</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="score">score</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="primary_error">primary_error</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="feedback">feedback</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="is_test">is_test</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR></TABLE>>];
  "attempt_errors" [shape=plaintext, fontsize=9, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="black"><FONT COLOR="white"><B>attempt_errors</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="attempt_id">attempt_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="code">code</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="detail">detail</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR></TABLE>>];
  "lessons" [shape=plaintext, fontsize=9, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="black"><FONT COLOR="white"><B>lessons</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="order_index">order_index</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="track">track</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="title">title</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="objectives">objectives</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at">updated_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR></TABLE>>];
  "lesson_progress" [shape=plaintext, fontsize=9, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="black"><FONT COLOR="white"><B>lesson_progress</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">user_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="lesson_id">lesson_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="started_at">started_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="completed_at">completed_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR></TABLE>>];
  "review_items" [shape=plaintext, fontsize=9, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="black"><FONT COLOR="white"><B>review_items</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="lesson_id">lesson_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="skill_id">skill_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="mode">mode</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="front">front</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="back">back</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="grading_strategy">grading_strategy</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="answer_key">answer_key</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="grader_config">grader_config</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="provenance">provenance</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR></TABLE>>];
  "review_states" [shape=plaintext, fontsize=9, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="black"><FONT COLOR="white"><B>review_states</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">user_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="review_item_id">review_item_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="stage">stage</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="interval_days">interval_days</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="due_at">due_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="success_streak">success_streak</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="failure_count">failure_count</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="last_reviewed_at">last_reviewed_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR></TABLE>>];
  "review_attempts" [shape=plaintext, fontsize=9, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="black"><FONT COLOR="white"><B>review_attempts</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="review_state_id">review_state_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="answer">answer</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="correct">correct</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="rating">rating</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="response_time_ms">response_time_ms</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="due_before">due_before</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR></TABLE>>];
  "practice_attempts" [shape=plaintext, fontsize=9, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="black"><FONT COLOR="white"><B>practice_attempts</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">user_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="kind">kind</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="level">level</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="question">question</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="answer">answer</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="correct">correct</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="primary_error">primary_error</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="is_test">is_test</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR></TABLE>>];
  "skills" [shape=plaintext, fontsize=9, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="black"><FONT COLOR="white"><B>skills</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name">name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="domain">domain</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="srs_code">srs_code</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="group_code">group_code</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ready_threshold">ready_threshold</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="mastery_threshold">mastery_threshold</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR></TABLE>>];
  "mastery_states" [shape=plaintext, fontsize=9, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="black"><FONT COLOR="white"><B>mastery_states</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">user_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="skill_id">skill_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="score">score</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="attempts_count">attempts_count</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="last_error_code">last_error_code</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at">updated_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR></TABLE>>];
  "mastery_events" [shape=plaintext, fontsize=9, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="black"><FONT COLOR="white"><B>mastery_events</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">user_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="skill_id">skill_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="source">source</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="source_id">source_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="result">result</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="counted">counted</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="score_before">score_before</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="score_after">score_after</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="vn_day">vn_day</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR></TABLE>>];
  "placement_results" [shape=plaintext, fontsize=9, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="black"><FONT COLOR="white"><B>placement_results</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><B>user_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="answers">answers</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="taken_count">taken_count</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="completed_at">completed_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR></TABLE>>];
  "users":id -> "refresh_tokens":user_id [arrowhead=crow, arrowtail=tee, dir=both];
  "users":id -> "attempts":user_id [arrowhead=crow, arrowtail=tee, dir=both];
  "exercise_versions":id -> "attempts":exercise_version_id [arrowhead=crow, arrowtail=tee, dir=both];
  "attempts":id -> "attempt_errors":attempt_id [arrowhead=crow, arrowtail=tee, dir=both];
  "users":id -> "lesson_progress":user_id [arrowhead=crow, arrowtail=tee, dir=both];
  "lessons":id -> "lesson_progress":lesson_id [arrowhead=crow, arrowtail=tee, dir=both];
  "lessons":id -> "review_items":lesson_id [arrowhead=crow, arrowtail=tee, dir=both];
  "skills":id -> "review_items":skill_id [arrowhead=crow, arrowtail=tee, dir=both];
  "users":id -> "review_states":user_id [arrowhead=crow, arrowtail=tee, dir=both];
  "review_items":id -> "review_states":review_item_id [arrowhead=crow, arrowtail=tee, dir=both];
  "review_states":id -> "review_attempts":review_state_id [arrowhead=crow, arrowtail=tee, dir=both];
  "users":id -> "practice_attempts":user_id [arrowhead=crow, arrowtail=tee, dir=both];
  "users":id -> "mastery_states":user_id [arrowhead=crow, arrowtail=tee, dir=both];
  "skills":id -> "mastery_states":skill_id [arrowhead=crow, arrowtail=tee, dir=both];
  "users":id -> "mastery_events":user_id [arrowhead=crow, arrowtail=tee, dir=both];
  "skills":id -> "mastery_events":skill_id [arrowhead=crow, arrowtail=tee, dir=both];
  "users":id -> "placement_results":user_id [arrowhead=crow, arrowtail=tee, dir=both];
}
