digraph G {
  graph [fontname="Liberation Serif", bgcolor=white, pad=0.2 , rankdir=LR, nodesep=0.25, ranksep=0.9, splines=true];
  node [fontname="Liberation Serif", fontsize=11, color=black];
  edge [fontname="Liberation Serif", fontsize=9, color=black];
  "content_revisions" [shape=plaintext, fontsize=9, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="black"><FONT COLOR="white"><B>content_revisions</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="lesson_id">lesson_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="kind">kind</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="target">target</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="payload">payload</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="note">note</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_by">created_by</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="published_by">published_by</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="published_at">published_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR></TABLE>>];
  "admin_audit_log" [shape=plaintext, fontsize=9, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="black"><FONT COLOR="white"><B>admin_audit_log</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="actor_id">actor_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="action">action</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="target_type">target_type</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="target_id">target_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="detail">detail</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR></TABLE>>];
  "source_documents" [shape=plaintext, fontsize=9, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="black"><FONT COLOR="white"><B>source_documents</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="uploaded_by">uploaded_by</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="filename">filename</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="kind">kind</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="size_bytes">size_bytes</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="sha256">sha256</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="source_title">source_title</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="source_note">source_note</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="consent">consent</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="pages">pages</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="relevance_status">relevance_status</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="relevance_score">relevance_score</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="relevance_reason">relevance_reason</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="relevance_detail">relevance_detail</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="reviewed_by">reviewed_by</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="reviewed_at">reviewed_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="deleted_at">deleted_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR></TABLE>>];
  "ai_lesson_drafts" [shape=plaintext, fontsize=9, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="2" BGCOLOR="black"><FONT COLOR="white"><B>ai_lesson_drafts</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="document_id">document_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_by">created_by</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="page_from">page_from</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="page_to">page_to</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="content">content</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="engine_report">engine_report</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="model">model</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tokens_in">tokens_in</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tokens_out">tokens_out</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="published_lesson_id">published_lesson_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at">updated_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8"> </FONT></TD></TR></TABLE>>];
  "source_documents":id -> "ai_lesson_drafts":document_id [arrowhead=crow, arrowtail=tee, dir=both];
}
