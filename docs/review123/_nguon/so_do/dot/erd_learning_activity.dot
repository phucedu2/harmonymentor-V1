graph G {
  graph [fontname="Liberation Serif", bgcolor=white, pad=0.2 , layout=neato, overlap=false, sep="+14", splines=true, size="7.2,9.2"];
  node [fontname="Liberation Serif", fontsize=11, color=black];
  edge [fontname="Liberation Serif", fontsize=9, color=black];
  "users" [shape=box, style=bold, fontsize=12];
  "refresh_tokens" [shape=box, style=bold, fontsize=12];
  "exercise_versions" [shape=box, style=bold, fontsize=12];
  "attempts" [shape=box, style=bold, fontsize=12];
  "attempt_errors" [shape=box, style=bold, fontsize=12];
  "lessons" [shape=box, style=bold, fontsize=12];
  "lesson_progress" [shape=box, style=bold, fontsize=12];
  "review_items" [shape=box, style=bold, fontsize=12];
  "review_states" [shape=box, style=bold, fontsize=12];
  "review_attempts" [shape=box, style=bold, fontsize=12];
  "practice_attempts" [shape=box, style=bold, fontsize=12];
  "skills" [shape=box, style=bold, fontsize=12];
  "mastery_states" [shape=box, style=bold, fontsize=12];
  "mastery_events" [shape=box, style=bold, fontsize=12];
  "placement_results" [shape=box, style=bold, fontsize=12];
  "R_refresh_tokens_users_user_id" [shape=diamond, fontsize=9, width=0.9, height=0.5, label="owns"];
  "users" -- "R_refresh_tokens_users_user_id" [label="1"];
  "R_refresh_tokens_users_user_id" -- "refresh_tokens" [label="n"];
  "R_attempts_users_user_id" [shape=diamond, fontsize=9, width=0.9, height=0.5, label="makes"];
  "users" -- "R_attempts_users_user_id" [label="1"];
  "R_attempts_users_user_id" -- "attempts" [label="n"];
  "R_attempts_exercise_versions_exercise_version_id" [shape=diamond, fontsize=9, width=0.9, height=0.5, label="answers"];
  "exercise_versions" -- "R_attempts_exercise_versions_exercise_version_id" [label="1"];
  "R_attempts_exercise_versions_exercise_version_id" -- "attempts" [label="n"];
  "R_attempt_errors_attempts_attempt_id" [shape=diamond, fontsize=9, width=0.9, height=0.5, label="diagnoses"];
  "attempts" -- "R_attempt_errors_attempts_attempt_id" [label="1"];
  "R_attempt_errors_attempts_attempt_id" -- "attempt_errors" [label="n"];
  "R_lesson_progress_users_user_id" [shape=diamond, fontsize=9, width=0.9, height=0.5, label="tracks"];
  "users" -- "R_lesson_progress_users_user_id" [label="1"];
  "R_lesson_progress_users_user_id" -- "lesson_progress" [label="n"];
  "R_lesson_progress_lessons_lesson_id" [shape=diamond, fontsize=9, width=0.9, height=0.5, label="progress of"];
  "lessons" -- "R_lesson_progress_lessons_lesson_id" [label="1"];
  "R_lesson_progress_lessons_lesson_id" -- "lesson_progress" [label="n"];
  "R_review_items_lessons_lesson_id" [shape=diamond, fontsize=9, width=0.9, height=0.5, label="has cards"];
  "lessons" -- "R_review_items_lessons_lesson_id" [label="1"];
  "R_review_items_lessons_lesson_id" -- "review_items" [label="n"];
  "R_review_items_skills_skill_id" [shape=diamond, fontsize=9, width=0.9, height=0.5, label="reviews"];
  "skills" -- "R_review_items_skills_skill_id" [label="1"];
  "R_review_items_skills_skill_id" -- "review_items" [label="n"];
  "R_review_states_users_user_id" [shape=diamond, fontsize=9, width=0.9, height=0.5, label="schedules"];
  "users" -- "R_review_states_users_user_id" [label="1"];
  "R_review_states_users_user_id" -- "review_states" [label="n"];
  "R_review_states_review_items_review_item_id" [shape=diamond, fontsize=9, width=0.9, height=0.5, label="state of"];
  "review_items" -- "R_review_states_review_items_review_item_id" [label="1"];
  "R_review_states_review_items_review_item_id" -- "review_states" [label="n"];
  "R_review_attempts_review_states_review_state_id" [shape=diamond, fontsize=9, width=0.9, height=0.5, label="logs"];
  "review_states" -- "R_review_attempts_review_states_review_state_id" [label="1"];
  "R_review_attempts_review_states_review_state_id" -- "review_attempts" [label="n"];
  "R_practice_attempts_users_user_id" [shape=diamond, fontsize=9, width=0.9, height=0.5, label="practises"];
  "users" -- "R_practice_attempts_users_user_id" [label="1"];
  "R_practice_attempts_users_user_id" -- "practice_attempts" [label="n"];
  "R_mastery_states_users_user_id" [shape=diamond, fontsize=9, width=0.9, height=0.5, label="masters"];
  "users" -- "R_mastery_states_users_user_id" [label="1"];
  "R_mastery_states_users_user_id" -- "mastery_states" [label="n"];
  "R_mastery_states_skills_skill_id" [shape=diamond, fontsize=9, width=0.9, height=0.5, label="measured"];
  "skills" -- "R_mastery_states_skills_skill_id" [label="1"];
  "R_mastery_states_skills_skill_id" -- "mastery_states" [label="n"];
  "R_mastery_events_users_user_id" [shape=diamond, fontsize=9, width=0.9, height=0.5, label="history"];
  "users" -- "R_mastery_events_users_user_id" [label="1"];
  "R_mastery_events_users_user_id" -- "mastery_events" [label="n"];
  "R_mastery_events_skills_skill_id" [shape=diamond, fontsize=9, width=0.9, height=0.5, label="event of"];
  "skills" -- "R_mastery_events_skills_skill_id" [label="1"];
  "R_mastery_events_skills_skill_id" -- "mastery_events" [label="n"];
  "R_placement_results_users_user_id" [shape=diamond, fontsize=9, width=0.9, height=0.5, label="takes"];
  "users" -- "R_placement_results_users_user_id" [label="1"];
  "R_placement_results_users_user_id" -- "placement_results" [label="1"];
}
