graph G {
  graph [fontname="Liberation Serif", bgcolor=white, pad=0.2 , layout=neato, overlap=false, sep="+4"];
  node [fontname="Liberation Serif", fontsize=11, color=black];
  edge [fontname="Liberation Serif", fontsize=9, color=black];
  E [shape=box, style=bold, fontsize=16, label="review_items"];
  a0 [shape=ellipse, fontsize=14, margin="0.05,0.02", label=<<U>id</U>>];
  E -- a0 [len=2.1];
  a1 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="lesson_id"];
  E -- a1 [len=2.1];
  a2 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="skill_id"];
  E -- a2 [len=2.1];
  a3 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="mode"];
  E -- a3 [len=2.1];
  a4 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="front"];
  E -- a4 [len=2.1];
  a5 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="back"];
  E -- a5 [len=2.1];
  a6 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="grading_strategy"];
  E -- a6 [len=2.1];
  a7 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="answer_key"];
  E -- a7 [len=2.1];
  a8 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="grader_config"];
  E -- a8 [len=2.1];
  a9 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="provenance"];
  E -- a9 [len=2.1];
}
