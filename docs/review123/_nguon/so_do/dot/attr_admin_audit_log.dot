graph G {
  graph [fontname="Liberation Serif", bgcolor=white, pad=0.2 , layout=neato, overlap=false, sep="+4"];
  node [fontname="Liberation Serif", fontsize=11, color=black];
  edge [fontname="Liberation Serif", fontsize=9, color=black];
  E [shape=box, style=bold, fontsize=16, label="admin_audit_log"];
  a0 [shape=ellipse, fontsize=14, margin="0.05,0.02", label=<<U>id</U>>];
  E -- a0 [len=1.6];
  a1 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="actor_id"];
  E -- a1 [len=1.6];
  a2 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="action"];
  E -- a2 [len=1.6];
  a3 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="target_type"];
  E -- a3 [len=1.6];
  a4 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="target_id"];
  E -- a4 [len=1.6];
  a5 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="detail"];
  E -- a5 [len=1.6];
  a6 [shape=ellipse, fontsize=14, margin="0.05,0.02", label="created_at"];
  E -- a6 [len=1.6];
}
